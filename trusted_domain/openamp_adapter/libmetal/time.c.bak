/*
 * libmetal FreeRTOS 时间操作实现
 *
 * Copyright (c) 2025 Quard Star Project
 *
 * 本文件实现 libmetal 在 FreeRTOS 上的时间操作
 * 使用 RISC-V 的 time CSR 和 mtime CSR
 * 参考：libmetal/lib/system/generic/time.c
 */

#include "metal/time.h"
#include "metal/sys.h"

#include "FreeRTOS.h"
#include "task.h"

#include <stdint.h>

/* ============================================================================
 * RISC-V 时间寄存器定义
 * ============================================================================ */

/**
 * RISC-V mtime 寄存器地址 (CLINT)
 *
 * QEMU RISC-V 通常将 CLINT 映射到 0x02004000
 * 但为了兼容性，我们使用 time CSR
 */

#define CLINT_MTIME_OFFSET        0xBFF8  /* mtime offset from CLINT_BASE */
#define CLINT_BASE                0x02000000

/**
 * CLINT 寄存器访问
 */
#define CLINT_REG(reg)            (*(volatile uint64_t *)((reg)))

/**
 * RISC-V 时间频率
 * QEMU 默认为 10 MHz
 */
#define RISCV_TIMEBASE_FREQ       10000000ULL  /* 10 MHz */

/* ============================================================================
 * 时间戳操作（使用 time CSR）
 * ============================================================================ */

/**
 * 读取 time CSR
 *
 * 返回自从启动以来的时钟周期数
 */
static inline uint64_t riscv_read_time(void)
{
    uint64_t time;

    /* 使用 rdtime 伪指令读取 time CSR */
    asm volatile(
        "rdtime %0"
        : "=r"(time)
    );

    return time;
}

/**
 * 获取当前时间戳（纳秒）
 */
uint64_t metal_current_time(void)
{
    uint64_t cycles;

    cycles = riscv_read_time();

    /* 转换为纳秒: cycles * 1e9 / freq */
    return (cycles * 1000000000ULL) / RISCV_TIMEBASE_FREQ;
}

/**
 * 获取当前时间戳（微秒）
 */
uint64_t metal_current_time_us(void)
{
    uint64_t cycles;

    cycles = riscv_read_time();

    /* 转换为微秒: cycles * 1e6 / freq */
    return (cycles * 1000000ULL) / RISCV_TIMEBASE_FREQ;
}

/**
 * 获取当前时间戳（毫秒）
 */
uint64_t metal_current_time_ms(void)
{
    uint64_t cycles;

    cycles = riscv_read_time();

    /* 转换为毫秒: cycles * 1000 / freq */
    return (cycles * 1000ULL) / RISCV_TIMEBASE_FREQ;
}

/**
 * 延迟指定微秒
 */
void metal_sleep_us(uint32_t delay_us)
{
    uint64_t start;
    uint64_t elapsed;
    uint64_t delay_cycles;

    start = riscv_read_time();
    delay_cycles = (delay_us * RISCV_TIMEBASE_FREQ) / 1000000ULL;

    do {
        elapsed = riscv_read_time() - start;
    } while (elapsed < delay_cycles);
}

/**
 * 延迟指定毫秒
 */
void metal_sleep_ms(uint32_t delay_ms)
{
    uint64_t start;
    uint64_t elapsed;
    uint64_t delay_cycles;

    start = riscv_read_time();
    delay_cycles = (delay_ms * RISCV_TIMEBASE_FREQ) / 1000ULL;

    do {
        elapsed = riscv_read_time() - start;
    } while (elapsed < delay_cycles);
}

/**
 * 延迟指定秒
 */
void metal_sleep(uint32_t delay_sec)
{
    uint64_t i;

    for (i = 0; i < delay_sec; i++) {
        metal_sleep_ms(1000);
    }
}

/* ============================================================================
 * 高精度时间延迟
 * ============================================================================ */

/**
 * 忙等待延迟指定 CPU 周期数
 *
 * @param cycles  延迟的周期数
 */
void metal_delay_cycles(uint64_t cycles)
{
    uint64_t start;

    start = riscv_read_time();

    while ((riscv_read_time() - start) < cycles) {
        /* 等待 */
    }
}

/* ============================================================================
 * 时间频率获取
 * ============================================================================ */

/**
 * 获取系统时钟频率
 *
 * @return 时钟频率
 */
unsigned long metal_get_timebase_freq(void)
{
    return RISCV_TIMEBASE_FREQ;
}

/**
 * 获取 CPU 频率
 *
 * QEMU 中通常与 timebase 相同
 */
unsigned long metal_get_cpu_freq(void)
{
    return RISCV_TIMEBASE_FREQ;
}
