/*
 * libmetal FreeRTOS I/O 接口实现
 *
 * Copyright (c) 2025 Quard Star Project
 *
 * 本文件实现 libmetal 在 FreeRTOS 上的 I/O 接口
 * 主要处理共享内存 (vring 和 rpmsg buffers) 的映射
 * 参考：libmetal/lib/system/generic/io.c
 */

#include "metal/io.h"
#include "metal/device.h"
#include "metal/sys.h"

#include "hwspecs.h"

#include <stdlib.h>
#include <stdint.h>
#include <string.h>

/* ============================================================================
 * FreeRTOS 内存映射实现
 * ============================================================================ */

/**
 * 关闭 I/O 区域
 * FreeRTOS 上无需特殊处理
 */
static void metal_freertos_io_close(struct metal_io_region *io)
{
    (void)io;
    /* 无需操作 */
}

/**
 * 获取物理地址
 */
static metal_phys_addr_t metal_freertos_offset_to_phys(struct metal_io_region *io,
                                                      unsigned long offset)
{
    if (!io || !io->physmap) {
        return METAL_BAD_PHYS;
    }

    return io->physmap[offset >> io->page_shift] + (offset & (metal_phys_addr_t)((1UL << io->page_shift) - 1));
}

/**
 * 获取偏移地址
 */
static unsigned long metal_freertos_phys_to_offset(struct metal_io_region *io,
                                                   metal_phys_addr_t phys)
{
    unsigned long page;

    if (!io || !io->physmap) {
        return METAL_BAD_OFFSET;
    }

    /* 简化实现：假设连续内存 */
    page = (phys - io->physmap[0]) >> io->page_shift;

    return (page << io->page_shift) + (phys & ((1UL << io->page_shift) - 1));
}

/* ============================================================================
 * I/O 操作 - 读/写/阻塞等
 * ============================================================================ */

/**
 * 读操作
 */
static uint64_t metal_freertos_io_read(struct metal_io_region *io,
                                      unsigned long offset,
                                      memory_order order,
                                      int width)
{
    void *ptr;
    uint64_t value = 0;

    (void)order;  /* 简化实现，忽略 memory order */

    if (!io || !io->virt) {
        return 0;
    }

    ptr = (void *)((uintptr_t)io->virt + offset);

    switch (width) {
    case 1:
        value = *(uint8_t *)ptr;
        break;
    case 2:
        value = *(uint16_t *)ptr;
        break;
    case 4:
        value = *(uint32_t *)ptr;
        break;
    case 8:
        value = *(uint64_t *)ptr;
        break;
    }

    return value;
}

/**
 * 写操作
 */
static void metal_freertos_io_write(struct metal_io_region *io,
                                    unsigned long offset,
                                    uint64_t value,
                                    memory_order order,
                                    int width)
{
    void *ptr;

    (void)order;  /* 简化实现，忽略 memory order */

    if (!io || !io->virt) {
        return;
    }

    ptr = (void *)((uintptr_t)io->virt + offset);

    switch (width) {
    case 1:
        *(uint8_t *)ptr = (uint8_t)value;
        break;
    case 2:
        *(uint16_t *)ptr = (uint16_t)value;
        break;
    case 4:
        *(uint32_t *)ptr = (uint32_t)value;
        break;
    case 8:
        *(uint64_t *)ptr = (uint64_t)value;
        break;
    }

    /* 写后屏障 */
    asm volatile("fence ow,ow" ::: "memory");
}

/**
 * 块读操作
 */
static int metal_freertos_io_block_read(struct metal_io_region *io,
                                       unsigned long offset,
                                       void *restrict dst,
                                       memory_order order,
                                       int len)
{
    void *ptr;

    (void)order;  /* 简化实现，忽略 memory order */

    if (!io || !io->virt || !dst) {
        return -EINVAL;
    }

    ptr = (void *)((uintptr_t)io->virt + offset);
    memcpy(dst, ptr, len);

    /* 读后屏障 */
    asm volatile("fence ir,ir" ::: "memory");

    return 0;
}

/**
 * 块写操作
 */
static int metal_freertos_io_block_write(struct metal_io_region *io,
                                        unsigned long offset,
                                        const void *restrict src,
                                        memory_order order,
                                        int len)
{
    void *ptr;

    (void)order;  /* 简化实现，忽略 memory order */

    if (!io || !io->virt || !src) {
        return -EINVAL;
    }

    ptr = (void *)((uintptr_t)io->virt + offset);
    memcpy(ptr, src, len);

    /* 写后屏障 */
    asm volatile("fence ow,ow" ::: "memory");

    return 0;
}

/**
 * 内存填充操作
 */
static void metal_freertos_io_block_set(struct metal_io_region *io,
                                       unsigned long offset,
                                       unsigned char value,
                                       memory_order order,
                                       int len)
{
    void *ptr;

    (void)order;  /* 简化实现，忽略 memory order */

    if (!io || !io->virt) {
        return;
    }

    ptr = (void *)((uintptr_t)io->virt + offset);
    memset(ptr, value, len);
}

/**
 * 内存复制操作
 */
static void metal_freertos_io_memcpy(struct metal_io_region *io,
                                    unsigned long dst_offset,
                                    unsigned long src_offset,
                                    int len)
{
    void *dst, *src;

    if (!io || !io->virt) {
        return;
    }

    dst = (void *)((uintptr_t)io->virt + dst_offset);
    src = (void *)((uintptr_t)io->virt + src_offset);
    memmove(dst, src, len);
}

/* ============================================================================
 * I/O 区域操作表
 * ============================================================================ */

static const struct metal_io_ops metal_freertos_io_ops = {
    .close = metal_freertos_io_close,
    .read = metal_freertos_io_read,
    .write = metal_freertos_io_write,
    .block_read = metal_freertos_io_block_read,
    .block_write = metal_freertos_io_block_write,
    .block_set = metal_freertos_io_block_set,
    .offset_to_phys = metal_freertos_offset_to_phys,
    .phys_to_offset = metal_freertos_phys_to_offset,
};

/* ============================================================================
 * 导出的 API
 * ============================================================================ */

/**
 * 注册共享内存 I/O 区域
 *
 * 使用场景：
 * - vring0 (RX) @ 0xbf700000
 * - vring1 (TX) @ 0xbf702000
 * - rpmsg buffers @ 0xbf704000
 * - resource table @ 0xbf70c000
 */
int metal_register_shared_memory(struct metal_io_region *io,
                                 metal_phys_addr_t physmap,
                                 size_t size,
                                 const char *name)
{
    (void)name;

    if (!io) {
        return -EINVAL;
    }

    /* FreeRTOS 上物理地址 = 虚拟地址 */
    void *virt = (void *)physmap;

    /* 初始化 I/O 区域 */
    metal_io_init(io, virt, &physmap, size, -1, 0, &metal_freertos_io_ops);

    return 0;
}
