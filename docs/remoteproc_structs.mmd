  %% ==== virtio_rpmsg_bus ====
  subgraph VRPMSG["struct virtio_rpmsg_bus"]
    direction TB
    VRPMSG_probe["probe()"]
    VRPMSG_remove["remove()"]
  end

  %% ==== reserved memory ====
  subgraph RESMEM["reserved_memory (DMA pool)"]
    direction TB
    RESMEM_base["base"]
    RESMEM_size["size"]
  end

  %% ==== 关系（箭头） ====
  %% pdev.dev -> struct device
  PDEV_dev --> DEV
  %% pdev -> priv
  PDEV_name --> QSR

  %% priv members -> target structs
  QSR_dev --> DEV
  QSR_rproc --> RPROC
  QSR_mailbox --> MB
  QSR_rsc --> RSCT

  %% rproc members -> target structs
  RPROC_ops --> RPOPS
  RPROC_table --> RSCT
  RPROC_vdevs --> RVDEV

  %% rvdev -> rvring
  RVDEV_vrings --> RVRING

  %% resource table layout
  RSCT_off --> RSC_HDR
  RSC_HDR --> RSC_VDEV
  RSC_VDEV --> RSC_VRING

  %% virtio/rpmsg uses vdev
  VRPMSG_probe --> RVDEV

  %% device -> reserved memory
  DEV --> RESMEM
