flowchart TB
  %% ==== 核心结构：quard_star_rproc（主体） ====
  subgraph QSR["struct quard_star_rproc"]
    direction TB
    QSR_dev["dev"]
    QSR_rproc["rproc"]
    QSR_mailbox["mailbox_base"]
    QSR_irq["vq_irq"]
    QSR_rsc["rsc_table"]
    QSR_rscsz["rsc_table_size"]
  end

