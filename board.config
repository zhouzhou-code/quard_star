#!/bin/bash
# ==============================================================================
# Quard Star 板级 / 构建配置  ——  被 build.sh source
#
#   依赖: 仅需 SHELL_FOLDER（build.sh 在 source 本文件前已设置好）
#   原则: 路径 / 版本 / 打包布局的改动，只动这一个文件即可
#   目录骨架: source/(纯上游)  project/(我们写的:源码+配置)  toolchain/  output/
# ==============================================================================

# ---- 目录骨架 ----
SOURCE_DIR="${SHELL_FOLDER}/source"      # 上游源码
PROJECT_DIR="${SHELL_FOLDER}/project"    # 编排资源(dts/configs/patches/scripts/rootfs_overlay)
DRIVERS_DIR="${PROJECT_DIR}/drivers"     # 树外内核驱动(我们写的)
OUTPUT_DIR="${SHELL_FOLDER}/output"      # 构建产物
SYSROOT_DIR="${SHELL_FOLDER}/sysroot"    # 软链到 buildroot staging(带头文件的开发 sysroot)

# ---- 并行度（可用环境变量 JOBS 覆盖）----
JOBS="${JOBS:-$(nproc)}"

# ---- 交叉工具链（置于工程内 toolchain/，可用 TOOLCHAIN_DIR 覆盖）----
# 自动探测工具链目录名，兼容不同命名(gcc15-/gcc-/...)；探测不到则回退默认名
TOOLCHAIN_DIR="${TOOLCHAIN_DIR:-${SHELL_FOLDER}/toolchain}"
_glib_tc_dir="$(ls -d "${TOOLCHAIN_DIR}"/*riscv64-unknown-linux-gnu 2>/dev/null | head -1)"
_newlib_tc_dir="$(ls -d "${TOOLCHAIN_DIR}"/*riscv64-unknown-elf 2>/dev/null | head -1)"
GLIB_ELF_CROSS_COMPILE_DIR="${_glib_tc_dir:-${TOOLCHAIN_DIR}/gcc-riscv64-unknown-linux-gnu}"
NEWLIB_ELF_CROSS_COMPILE_DIR="${_newlib_tc_dir:-${TOOLCHAIN_DIR}/gcc-riscv64-unknown-elf}"
GLIB_ELF_CROSS_PREFIX="${GLIB_ELF_CROSS_COMPILE_DIR}/bin/riscv64-unknown-linux-gnu"
NEWLIB_ELF_CROSS_PREFIX="${NEWLIB_ELF_CROSS_COMPILE_DIR}/bin/riscv64-unknown-elf"

# ---- 上游组件源码路径（source/，纯上游）----
QEMU_DIR="${SOURCE_DIR}/qemu-8.0.2"
OPENSBI_DIR="${SOURCE_DIR}/opensbi-1.2"
UBOOT_DIR="${SOURCE_DIR}/u-boot-2026.01"
KERNEL_DIR="${SOURCE_DIR}/linux"

# ---- 自写板级源码（project/，与上游 source/ 区分）----
BOOT_DIR="${PROJECT_DIR}/boot"                     # 一级 BL (start.s/boot.lds)
TRUSTED_DOMAIN_DIR="${PROJECT_DIR}/trusted_domain" # FreeRTOS 域 (OpenAMP rpmsg)
FREERTOS_DIR="${TRUSTED_DOMAIN_DIR}"

# ---- 编排资源（project/）----
DTS_DIR="${PROJECT_DIR}/dts"
LINUX_DRIVER_DIR="${DRIVERS_DIR}"

# ---- OpenAMP 上游库（source/third_party/，仅可信域裸机用）----
# libmetal 用其自带 freertos system 层编译；FreeRTOS 侧 rpmsg 用 open-amp。
# 编译 flag/include 由 build_libmetal/build_openamp_lib 与 trusted_domain/Makefile 各自维护。
LIBMETAL_DIR="${SOURCE_DIR}/third_party/libmetal"
OPENAMP_DIR="${SOURCE_DIR}/third_party/open-amp"
BSP_INCLUDE_DIR="${TRUSTED_DOMAIN_DIR}/bsp_include"

# ---- Linux 内核版本 / patch / config（patches、configs 收进 project/）----
KERNEL_VER="v6.10"   # 可选: v6.10 / v5.10
PATCH_FILE="${PROJECT_DIR}/patches/quard_star_linux_${KERNEL_VER}.patch"
CONFIG_FILE="${PROJECT_DIR}/configs/kernel-${KERNEL_VER}_defconfig"
VERSION_MARKER="${SHELL_FOLDER}/.current_kernel_ver"

# ---- 固件打包布局（声明式，取代写死的 dd seek=）----
#   每项格式: "偏移KB:产物相对 OUTPUT_DIR 的路径"
#   pack_firmware 会遍历本表并做越界/重叠校验
FW_SIZE_KB=32768     # fw.bin 总大小 = 32 MiB
FW_LAYOUT=(
    "0:lowlevelboot/lowlevel_fw.bin"
    "512:opensbi/quard_star_sbi.dtb"
    "1024:uboot/quard_star_uboot.dtb"
    "2048:opensbi/fw_jump.bin"
    "3072:trusted_domain/resource_table.bin"
    "4096:trusted_domain/trusted_fw.bin"
    "8192:uboot/u-boot.bin"
)

# ---- rootfs: 由 Buildroot 构建(busybox 是其内的包)，产 rootfs.tar 由 build_rootfs 解入分区 ----
# 注意: buildroot 不能以 root 身份构建; 直接 ./build.sh(不加 sudo)，脚本会在 rootfs 阶段自行提权
#       联网需代理时构建前 export HTTP_PROXY/HTTPS_PROXY/ALL_PROXY(build.sh 会透传给 buildroot)
BUILDROOT_DIR="${SOURCE_DIR}/buildroot"
BUILDROOT_OUT="${OUTPUT_DIR}/buildroot"
BUILDROOT_DEFCONFIG="${PROJECT_DIR}/configs/buildroot_quard_star_defconfig"
BUILDROOT_ROOTFS_TAR="${BUILDROOT_OUT}/images/rootfs.tar"
# 缺失时 build_buildroot 自动克隆此版本(buildroot 树体积大，已 gitignore，不纳入仓库)
BUILDROOT_VERSION="2026.02.2"
BUILDROOT_REPO="https://github.com/buildroot/buildroot.git"
