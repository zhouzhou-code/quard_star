#!/bin/bash
# ==============================================================================
# Quard Star 板级 / 构建配置  ——  被 build.sh source
#
#   依赖: 仅需 SHELL_FOLDER（build.sh 在 source 本文件前已设置好）
#   原则: 路径 / 版本 / 打包布局的改动，只动这一个文件即可
#   目录骨架(Aura 风格): source/  project/  drivers/  toolchain/  output/
# ==============================================================================

# ---- 目录骨架 ----
SOURCE_DIR="${SHELL_FOLDER}/source"      # 上游源码
PROJECT_DIR="${SHELL_FOLDER}/project"    # 编排资源(dts/configs/patches/scripts/rootfs_overlay)
DRIVERS_DIR="${SHELL_FOLDER}/drivers"    # 树外内核驱动
OUTPUT_DIR="${SHELL_FOLDER}/output"      # 构建产物
SYSROOT_DIR="${SHELL_FOLDER}/sysroot"    # 应用层开发用的完整 rootfs 副本

# ---- 并行度（可用环境变量 JOBS 覆盖）----
JOBS="${JOBS:-$(nproc)}"

# ---- 交叉工具链（置于工程内 toolchain/，可用 TOOLCHAIN_DIR 覆盖）----
TOOLCHAIN_DIR="${TOOLCHAIN_DIR:-${SHELL_FOLDER}/toolchain}"
GLIB_ELF_CROSS_COMPILE_DIR="${TOOLCHAIN_DIR}/gcc15-riscv64-unknown-linux-gnu"
GLIB_ELF_CROSS_PREFIX="${GLIB_ELF_CROSS_COMPILE_DIR}/bin/riscv64-unknown-linux-gnu"
NEWLIB_ELF_CROSS_COMPILE_DIR="${TOOLCHAIN_DIR}/gcc-riscv64-unknown-elf"
NEWLIB_ELF_CROSS_PREFIX="${NEWLIB_ELF_CROSS_COMPILE_DIR}/bin/riscv64-unknown-elf"

# ---- 各组件源码路径（source/）----
QEMU_DIR="${SOURCE_DIR}/qemu-8.0.2"
BOOT_DIR="${SOURCE_DIR}/boot"
OPENSBI_DIR="${SOURCE_DIR}/opensbi-1.2"
UBOOT_DIR="${SOURCE_DIR}/u-boot-2026.01"
KERNEL_DIR="${SOURCE_DIR}/linux"
BUSYBOX_DIR="${SOURCE_DIR}/busybox-1.36.1"
TRUSTED_DOMAIN_DIR="${SOURCE_DIR}/trusted_domain"
FREERTOS_DIR="${TRUSTED_DOMAIN_DIR}"

# ---- 编排资源（project/）----
DTS_DIR="${PROJECT_DIR}/dts"
BUSYBOX_ROOT_SCRIPT="${PROJECT_DIR}/rootfs_overlay"
LINUX_DRIVER_DIR="${DRIVERS_DIR}"

# ---- OpenAMP（libmetal / open-amp 已并入 source/）----
LIBMETAL_DIR="${SOURCE_DIR}/libmetal"
OPENAMP_DIR="${SOURCE_DIR}/open-amp"
OPENAMP_ADAPTER_DIR="${TRUSTED_DOMAIN_DIR}/openamp_adapter"
BSP_INCLUDE_DIR="${TRUSTED_DOMAIN_DIR}/bsp_include"

# ---- FreeRTOS / 裸机编译选项（OpenAMP 适配层）----
CFLAGS_FREERTOS="-march=rv64imafdcv -mabi=lp64d -mcmodel=medany \
                 -ffunction-sections -fdata-sections \
                 -Wall -Wextra \
                 -I${OPENAMP_ADAPTER_DIR}/include \
                 -I${BSP_INCLUDE_DIR} \
                 -I${LIBMETAL_DIR}/lib/include \
                 -I${OPENAMP_DIR}/lib/include \
                 -I${TRUSTED_DOMAIN_DIR} \
                 -I${TRUSTED_DOMAIN_DIR}/FreeRTOS-Kernel-v10.4.3/include \
                 -I${TRUSTED_DOMAIN_DIR}/FreeRTOS-Kernel-v10.4.3/portable/GCC/RISC-V \
                 -DFREERTOS -O2 -g"

# ---- Linux 内核版本 / patch / config（patches、configs 收进 project/）----
KERNEL_VER="v6.10"   # 可选: v6.10 / v5.10
PATCH_FILE="${PROJECT_DIR}/patches/quard_star_linux_${KERNEL_VER}.patch"
CONFIG_FILE="${PROJECT_DIR}/configs/${KERNEL_VER}_config"
VERSION_MARKER="${SHELL_FOLDER}/.current_kernel_ver"

# ---- 固件打包布局（声明式，取代写死的 dd seek=）----
#   每项格式: "偏移KB:产物相对 OUTPUT_DIR 的路径"
#   pack_firmware 会遍历本表并做越界/重叠校验
FW_SIZE_KB=32768     # fw.bin 总大小 = 32 MiB
FW_LAYOUT=(
    "0:lowlevelboot/lowlevel_fw.bin"
    "512:opensbi/quard_star_sbi.dtb"
    "1024:uboot/quard_star_uboot.dtb"
    "2048:opensbi/fw_jump.bin"
    "3072:trusted_domain/resource_table.bin"
    "4096:trusted_domain/trusted_fw.bin"
    "8192:uboot/u-boot.bin"
)
